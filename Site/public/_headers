# Cabeceras de Cloudflare Pages. El HTML no lleva caché larga: Pages lo sirve
# validándolo con su ETag, y un cambio de texto se ve enseguida.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'

# Las direcciones internas de Pages (producción y vistas previas): que Google
# no las indexe. Solo wasmish.com.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
