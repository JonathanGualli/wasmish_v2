# --- Secretos -----------------------------------------------------------------
# Cualquier .env en cualquier carpeta (Backend, Frontend, deploy, raíz...), con
# sus variantes .env.local, .env.production, etc. Solo los *.example se suben.
.env
.env.*
*.env
!*.env.example
!.env.example
# Certificados y claves (p. ej. el .pem del túnel SSH al server)
*.pem
*.key
*.p12
*.crt

# --- Dependencias -------------------------------------------------------------
node_modules/
# La raíz del monorepo no tiene package.json: un npm install lanzado aquí por
# error solo deja un lock huérfano. Cada workspace tiene el suyo.
/package-lock.json
/package.json

# --- Builds, cachés y artefactos generados ------------------------------------
dist/
dist-ssr/
build/
coverage/
.eslintcache
*.tsbuildinfo
.vite/
*.tgz

# --- Logs y temporales --------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
*.tmp
*.bak

# --- Sistema operativo y editores --------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# --- Adjuntos de WhatsApp descargados (en prod es un volumen Docker) ---------
Backend/media/

# --- Deploy (código copiado al server) ----------------------------------------
deploy/app/

# --- Claude Code (personal/local) ---------------------------------------------
# Las skills de .claude/skills y .agents/ SÍ se suben: son parte del proyecto.
.claude/settings.local.json
.claude/memory/
.claude/worktrees/

# --- Graphify (artefactos generados) ------------------------------------------
graphify-out/

# Mockups de brainstorming (visual companion)
.superpowers/

# Lockfiles de otros gestores: el proyecto usa npm (package-lock.json)
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml
