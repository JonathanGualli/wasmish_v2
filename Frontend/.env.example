# Frontend — variables públicas que Vite embebe en el bundle al compilar.
# Copiar a Frontend/.env. No son secretos: cualquiera las ve en el navegador.
# En producción el equivalente es deploy/build.env.example.

# Mismo valor que META_APP_ID del Backend.
VITE_META_APP_ID=
# Mismo valor que META_CONFIG_ID del Backend.
VITE_META_CONFIG_ID=
VITE_META_GRAPH_VERSION=v26.0
