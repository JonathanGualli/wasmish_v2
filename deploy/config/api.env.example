# Secretos del backend — copiar a config/api.env en el server y rellenar.
# NUNCA subir el api.env real a git.
NODE_ENV=production

# Mongo COMPARTIDO (prod-mongo-main). Conexión INTERNA por nombre de contenedor,
# sin TLS (contenedor↔contenedor dentro del host). authSource=wasmish.
# La api se une a prod-mongo-main-internal-net (ver compose.yml) para resolver el host.
MONGO_URI=mongodb://wasmish_app:CAMBIA_ESTA_PASS@prod-mongo-main-db-ct:27017/wasmish?authSource=wasmish

# Clave para JWT + derivación de cifrado. Generar: openssl rand -hex 32
TOKEN_SECRET=REEMPLAZAR_por_valor_aleatorio_largo

# Token propio para verificar el webhook de Meta (elige uno)
WHATSAPP_VERIFY_TOKEN=REEMPLAZAR_token_webhook

# Meta / WhatsApp
META_APP_ID=934885772537991
META_APP_SECRET=REEMPLAZAR_app_secret_real
META_CONFIG_ID=1556100009265518
META_GRAPH_VERSION=v26.0

# Origen del front (para CORS; mismo dominio en producción)
FRONTEND_ORIGIN=https://wasmish.solventyc.com
