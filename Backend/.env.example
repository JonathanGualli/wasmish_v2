# Backend — variables de entorno para desarrollo local.
# Copiar a Backend/.env y rellenar. NUNCA subir el .env real a git.
# En producción el equivalente es deploy/config/api.env.example.

# --- Base de datos -----------------------------------------------------------
# Mongo local. En producción apunta al Mongo compartido (ver deploy/README.md).
MONGO_URI=mongodb://127.0.0.1:27017/wasmish

# --- Secretos propios (no vienen de Meta) ------------------------------------
# Firma el JWT de la sesión y deriva la clave AES con la que se cifran los
# tokens de WhatsApp en la BD. Generar: openssl rand -hex 32
# Si se cambia, los tokens ya guardados dejan de poder descifrarse.
TOKEN_SECRET=

# Contraseña inventada que Meta repite en GET /api/webhook al registrar la URL
# del webhook. Tiene que coincidir con la que se escriba en el panel de Meta.
WHATSAPP_VERIFY_TOKEN=

# --- Meta / WhatsApp ---------------------------------------------------------
# Identificador público de la app de Meta.
META_APP_ID= 
# Secreto de la app. Firma los webhooks (sin él, POST /api/webhook responde 401
# a todo) y se usa para canjear el code del Embedded Signup.
# También lo necesita `npm run webhook:simulate`.
META_APP_SECRET=
# ID de la configuración de Embedded Signup (Facebook Login for Business).
META_CONFIG_ID=
META_GRAPH_VERSION=v26.0

# --- Opcionales (tienen valor por defecto) -----------------------------------
# Origen permitido por CORS. Por defecto http://localhost:5173.
# FRONTEND_ORIGIN=http://localhost:5173
# Carpeta de adjuntos descargados. Por defecto media/ (en .gitignore).
# MEDIA_DIR=media
# Tope por archivo en bytes. Por defecto 25 MB.
# MEDIA_MAX_BYTES=26214400
# Cookies seguras (secure + sameSite none). Solo en el servidor.
# NODE_ENV=production
# Envíos masivos. El modo de prueba NO llama a Meta; fuera de producción está
# encendido por defecto, para no mandar WhatsApps reales desde local.
# CAMPAIGN_DRY_RUN=true
# CAMPAIGN_RATE_PER_SECOND=10
# CAMPAIGN_MAX_RECIPIENTS=5000
